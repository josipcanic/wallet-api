{
  "name": "wallet-api",
  "version": "1.0.0",
  "description": "REST API for authenticated wallet management and transfers.",
  "main": "server.js",
  "scripts": {
    "start": "node ./server.js",
    "dev": "nodemon ./server.js",
    "knex": "knex",
    "db:reset": "NODE_ENV=test run-s db:migrate:down db:migrate:up db:seed",
    "db:migrate:down": "NODE_ENV=test knex migrate:rollback --all",
    "db:migrate:up": "NODE_ENV=test knex migrate:latest",
    "db:seed": "NODE_ENV=test knex seed:run",
    "test:run": "NODE_ENV=test mocha -r ./tests/apiTest.js \"tests/**/*.spec.js\"",
    "test": "run-s db:reset test:run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv-safe": "^9.1.0",
    "express": "^4.19.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "npm-run-all": "^4.1.5",
    "pg": "^8.11.5",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "eslint": "^8.57.1",
    "mocha": "^10.8.2",
    "nodemon": "^3.1.7",
    "prettier": "^3.8.2",
    "supertest": "^7.0.0"
  }
}
